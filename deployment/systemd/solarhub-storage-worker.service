[Unit]
Description=Solar Hub Storage Worker (Redis Stream → TimescaleDB)
Documentation=https://github.com/YOUR_USERNAME/solar-hub
# Start after the telemetry service so the Redis Stream and DB are ready
After=network.target postgresql.service redis-server.service solarhub-telemetry.service
Wants=postgresql.service redis-server.service
# If the telemetry service restarts, restart the storage worker too
BindsTo=solarhub-telemetry.service

[Service]
Type=exec
User=solarhub
Group=solarhub
WorkingDirectory=/opt/solarhub/app/system_b
Environment="PATH=/opt/solarhub/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="STORAGE_WORKER_NAME=worker-0"
EnvironmentFile=/opt/solarhub/app/.env
ExecStart=/opt/solarhub/venv/bin/python -m app.device_server.storage_worker
Restart=always
RestartSec=10
StandardOutput=append:/opt/solarhub/logs/storage-worker.log
StandardError=append:/opt/solarhub/logs/storage-worker-error.log

# Security hardening (same as other services)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/solarhub/logs /opt/solarhub/data

# Resource Limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
